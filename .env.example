# Remote LLM configuration (OpenAI-compatible /v1/chat/completions)
LLM_BASE_URL=http://192.168.56.1:8080/v1
LLM_MODEL=mlx-community/Qwen2.5-Coder-32B-Instruct-abliterated-4bit
LLM_AUTH_TOKEN=sk-your-token-here

# Optional tuning
# LLM_MAX_CONTEXT_TOKENS=128000      # context window; history is trimmed to fit
# LLM_MAX_TOOL_OUTPUT_TOKENS=4000    # cap per tool-result when re-sending history (0=off)
# LLM_PARSE_TEXT_TOOLCALLS=1         # recover tool calls emitted as text (local models); 0=off
# LLM_TEMPERATURE=0.7
# MCPC_DB_PATH=~/.mcpc/mcpc.db    # where sessions/memory are stored

# Agent mode (the `agent run <objective>` command)
# AGENT_MAX_STEPS=25              # hard cap on reason-act-observe iterations per run
# AGENT_AUTO_APPROVE_ALL=0        # 1 = fully autonomous (never prompt before a tool runs)
# AGENT_READONLY_PREFIXES=read,get,list,search,find,fetch,view,show,describe,query,lookup,inspect,scan,check,count
#                                 # tool-name prefixes auto-approved in hybrid mode (overrides the default list)
# AGENT_ALLOW=server__tool,...    # always auto-approve these exact tool names
# AGENT_DENY=server__tool,...     # always block these tool names (overrides allow)
